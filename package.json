{
  "name": "anthony-maiorana-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --ignore-lock",
    "build": "node scripts/sync-feed.mjs && astro build",
    "build:offline": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test && npm run build && node scripts/check-output.mjs",
    "feed:sync": "node scripts/sync-feed.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "astro": "7.4.11",
    "fast-xml-parser": "5.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "wrangler": "4.161.0"
  }
}
