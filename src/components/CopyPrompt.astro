---
interface Props { id: string; title: string; text: string; download?: string; }
const { id, title, text, download } = Astro.props;
---
<section class="copy-prompt" id={id} data-copy-prompt aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`}>{title}</h2>
  <p>This copies the scheduling request and all research and email instructions together. Paste the complete text into your AI assistant.</p>
  <div class="prompt-actions">
    <button class="button" type="button" data-copy-button hidden>Copy complete prompt</button>
    {download && <a class="text-link" href={download} download>Download as plain text</a>}
  </div>
  <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
  <details data-copy-details>
    <summary>Read or manually copy the prompt</summary>
    <label class="sr-only" for={`${id}-text`}>{title}</label>
    <textarea id={`${id}-text`} data-copy-text readonly rows={14} spellcheck="false">{text}</textarea>
  </details>
</section>

<script>
  import { installCopyPrompts } from '../scripts/copy-prompts';
  installCopyPrompts(document, navigator);
</script>
