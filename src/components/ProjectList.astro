---
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<div class="project-list">
  {projects.map((project, i) => <article class="project-row"><span class="row-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><p class="meta">{project.data.category}</p><h3><a href={`/projects/${project.id}/`}>{project.data.title}<span class="external-arrow" aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a></h3><p>{project.data.description}</p></div><span class:list={['status', { idea: project.data.status === 'Idea' }]}><span aria-hidden="true"></span>{project.data.status}</span></article>)}
</div>
