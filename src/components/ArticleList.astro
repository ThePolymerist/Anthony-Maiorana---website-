---
import { formatDate } from '../data/site';
interface Props { items: { title: string; url: string; date: string; description: string }[]; compact?: boolean; }
const { items, compact = false } = Astro.props;
---
<div class:list={['article-list', { compact }]}>
  {items.map((item, i) => <article class="article-row"><span class="row-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><p class="meta"><time datetime={item.date}>{formatDate(item.date)}</time> <span aria-hidden="true">/</span> The Polymerist</p><h3><a href={item.url}>{item.title}<span aria-hidden="true" class="external-arrow"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a></h3>{!compact && <p class="article-description">{item.description}</p>}</div></article>)}
</div>
