---
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/standard-italic.css';
import '../styles/global.css';
import { site, navigation } from '../data/site';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Science, writing & things in progress`;
const canonical = new URL(Astro.url.pathname, site.url);
const path = Astro.url.pathname;
const schema = {
  '@context': 'https://schema.org', '@type': 'Person', name: site.name,
  alternateName: 'Tony Maiorana', url: site.url,
  sameAs: [site.linkedin, site.github, site.polymerist],
  description: 'Chemist, medical-device reviewer, and writer of The Polymerist.',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ee" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="The Polymerist" href={`${site.polymerist}/feed`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={`${site.url}/social-card.png`} />
    <meta property="og:image:alt" content="Anthony Maiorana — Science, writing, and things in progress." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a href="/" class="identity" aria-label="Anthony Maiorana, home"><span class="monogram" aria-hidden="true">am<span><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></span><span>Anthony Maiorana<span class="identity-caption">A personal workshop</span></span></a>
      <button class="menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false">Menu <span aria-hidden="true">+</span></button>
      <nav id="main-navigation" class="nav-links" aria-label="Main navigation">
        {navigation.map(({ href, label }) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <div class="footer-top"><a href="/" class="footer-name">Anthony Maiorana<span>, PhD</span></a><div class="footer-links"><a href={site.polymerist}>The Polymerist <span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a><a href={site.github}>GitHub <span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a><a href={site.linkedin}>LinkedIn <span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a></div></div>
      <div class="footer-bottom"><p>Science, writing, and things in progress.<br />Washington, DC · © {new Date().getUTCFullYear()}</p><p class="disclaimer">A personal website. Views expressed are my own and do not represent the U.S. Food and Drug Administration or the U.S. government.</p></div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#main-navigation');
      const close = () => { toggle?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('is-open'); };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('is-open', open);
      });
      document.addEventListener('keydown', e => { if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); } });
      nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
    </script>
  </body>
</html>
