---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { papers, patents } from '../data/publications';
---
<BaseLayout title="Publications & patents" description="Scientific publications and patent records by Anthony Maiorana, spanning biobased epoxy resins, nanocomposites, cellulose, and specialty materials.">
  <PageIntro eyebrow="Research / Publications & patents" title="The scientific record." description="Research on the structure and performance of materials, from biobased epoxy resins to nanocomposites. Scientific publications appear under Anthony Maiorana." />
  <div class="wrap">
    <div class="collection-toolbar" id="publication-controls" hidden><div class="filter-buttons" role="group" aria-label="Publication type"><button type="button" data-filter="all" aria-pressed="true">All records</button><button type="button" data-filter="paper" aria-pressed="false">Papers</button><button type="button" data-filter="patent" aria-pressed="false">Patents & applications</button></div><label class="search-label" for="publication-search">Search<input type="search" id="publication-search" placeholder="Title, author, year…" /></label></div>
    <p class="result-count" id="result-count" role="status" aria-live="polite">{papers.length} papers · {patents.length} patent and application records</p>
    <p class="empty-state" id="empty-results" hidden>No records match that search. Try a shorter phrase or select all records.</p>
    <section class="collection-section" data-collection="paper" aria-labelledby="papers"><h2 id="papers">Peer-reviewed publications</h2>{papers.map(p => <article class="citation" data-record="paper"><span class="citation-year">{p.year}</span><div><h3>{p.doi ? <a href={`https://doi.org/${p.doi}`}>{p.title}<span class="external-arrow" aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a> : p.title}</h3><p class="authors">{p.authors}</p><p class="journal"><em>{p.journal}</em> · {p.citation}</p>{p.doi && <p class="meta" style="margin-top:9px">DOI: {p.doi}</p>}</div></article>)}</section>
    <section class="collection-section" data-collection="patent" aria-labelledby="patents"><h2 id="patents">Patents & applications</h2><p class="note" style="margin-bottom:25px">These are individual patent and application records. Related records may belong to the same patent family; this is not a count of distinct inventions.</p>{patents.map(p => <article class="citation" data-record="patent"><span class="citation-year" aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span><div><p class="meta" style="margin-bottom:9px">{p.kind}</p><h3>{p.url ? <a href={p.url}>{p.identifier}</a> : p.identifier}</h3><p class="authors">{p.inventors}</p></div></article>)}</section>
  </div>
  <script>
    const controls = document.querySelector<HTMLElement>('#publication-controls');
    const search = document.querySelector<HTMLInputElement>('#publication-search');
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const records = [...document.querySelectorAll<HTMLElement>('[data-record]')];
    let active = 'all';
    const update = () => {
      const term = (search?.value ?? '').trim().toLocaleLowerCase();
      let count = 0;
      records.forEach(record => { const matches = (active === 'all' || record.dataset.record === active) && (record.textContent ?? '').toLocaleLowerCase().includes(term); record.hidden = !matches; if (matches) count++; });
      document.querySelectorAll<HTMLElement>('[data-collection]').forEach(section => { section.hidden = ![...section.querySelectorAll<HTMLElement>('[data-record]')].some(r => !r.hidden); });
      const status = document.querySelector('#result-count'); if (status) status.textContent = `${count} ${count === 1 ? 'record' : 'records'} shown`;
      const empty = document.querySelector<HTMLElement>('#empty-results'); if (empty) empty.hidden = count > 0;
    };
    buttons.forEach(button => button.addEventListener('click', () => { active = button.dataset.filter ?? 'all'; buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button))); update(); }));
    search?.addEventListener('input', update);
    if (controls) controls.hidden = false;
  </script>
</BaseLayout>
