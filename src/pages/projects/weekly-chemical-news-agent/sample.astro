---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
const brief = await getEntry('briefs', '2026-11-21');
if (!brief) throw new Error('The sample briefing is missing');
const { Content } = await render(brief);
---
<BaseLayout title={brief.data.title} description={brief.data.description}>
  <article class="wrap project-article sample-brief">
    <header class="page-intro narrow">
      <a class="back-link" href="/projects/weekly-chemical-news-agent/">Back to the news agent</a>
      <p class="eyebrow">AI Tools / Sample output</p>
      <h1>{brief.data.title}</h1>
      <p class="lede">{brief.data.description}</p>
      <p class="note">This is a dated sample from a single interactive test. It is AI-generated, has incomplete source coverage, and is not a current news feed. Source limitations and the company coverage table appear below.</p>
    </header>
    <div class="prose narrow"><Content /></div>
  </article>
</BaseLayout>
