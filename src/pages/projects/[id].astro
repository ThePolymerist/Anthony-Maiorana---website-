---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../data/site';
export async function getStaticPaths() {
  return (await getCollection('projects')).map(project => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout title={project.data.title} description={project.data.description}>
  <article class="project-article wrap"><header class="page-intro narrow"><a class="back-link" href="/projects/">← Back to the workshop</a><p class="eyebrow">{project.data.category}</p><h1>{project.data.title}</h1><p class="lede">{project.data.description}</p><div class="project-meta"><span class:list={['status', { idea: project.data.status === 'Idea' }]}><span aria-hidden="true"></span>{project.data.status}</span><span class="meta">Updated <time datetime={project.data.updated}>{formatDate(project.data.updated)}</time></span></div></header><div class="prose narrow"><Content />{project.data.repository && <p><a href={project.data.repository}>View the repository <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></a></p>}</div></article>
</BaseLayout>
