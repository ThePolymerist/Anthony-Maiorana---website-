---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProjectList from '../../components/ProjectList.astro';
import { site } from '../../data/site';
---
<BaseLayout title="Projects" description="A notebook of Anthony Maiorana’s AI-assisted projects, experiments, and ideas. Follow what is being built, what has been tested, and what is still a question.">
  <PageIntro eyebrow="Projects / The workshop" title="Learning by making." description="A place to build useful things, document the decisions, and see what survives contact with real use. Each project starts with a question."><div class="hero-links"><a class="text-link" href={site.github}>On GitHub <span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a><a class="text-link" href="/ideas/">Ideas & explorations <span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a></div></PageIntro>
  <section class="wrap section" id="ai-tools" aria-labelledby="ai-tools-heading">
    <div class="section-heading"><div><p class="eyebrow">Prompts & practical workflows</p><h2 id="ai-tools-heading">AI Tools</h2></div></div>
    <p class="tools-intro">Free research instructions you can use with your own AI assistant. See a sample, copy a prompt, or download the files and adapt them.</p>
    <ProjectList category="AI Tools" />
  </section>
  <section class="wrap section" aria-labelledby="project-notebook-heading">
    <div class="section-heading"><h2 id="project-notebook-heading">Build journal & ideas</h2></div>
    <ProjectList excludeCategory="AI Tools" />
    <p class="note" style="margin-top:30px"><strong>A note on stages.</strong> An idea is a question worth exploring. A prototype is something that can be tried. Published work has a usable release. The labels here describe where each project stands.</p>
  </section>
</BaseLayout>
