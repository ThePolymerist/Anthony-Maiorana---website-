---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ArticleList from '../components/ArticleList.astro';
import writing from '../data/writing.json';
import { site, formatDate } from '../data/site';
---
<BaseLayout title="Writing" description="The Polymerist: independent writing by Tony Maiorana about polymer chemistry, industrial innovation, and the work of turning scientific knowledge into useful products.">
  <PageIntro eyebrow="Writing / The Polymerist" title="The world beyond the lab." description="A promising material is a beginning. I write about the people, processes, economics, and decisions that determine what happens next."><div class="hero-links"><a class="button" href={`${site.polymerist}/subscribe`}>Read & subscribe <span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a><a class="text-link" href={`${site.polymerist}/p/start-here-the-chemistry-behind-what`}>Start here <span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a></div></PageIntro>
  <div class="wrap"><section class="section content-grid"><div><p class="eyebrow">A useful place to begin</p></div><div><h2>The Lean Lab.</h2><p class="lede" style="margin:20px 0 24px">A practical guide for scientists exploring whether their research could become a viable product or company. Start with the commercial questions while there is still time to change the experiment.</p><a class="text-link" href={site.leanLab}>Read the guide <span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a></div></section>
    <section class="section"><div class="section-heading"><div><p class="eyebrow">From the publication</p><h2>{writing.mode === 'feed' ? 'Recent writing.' : 'Selected reading.'}</h2></div><a class="text-link" href={`${site.polymerist}/archive`}>Complete archive <span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a></div><ArticleList items={writing.items} /><p class="meta" style="margin-top:25px">{writing.mode === 'feed' ? 'Article index refreshed' : 'Selection checked'} {formatDate(writing.checkedAt)} · Full articles on The Polymerist</p></section>
  </div>
</BaseLayout>
