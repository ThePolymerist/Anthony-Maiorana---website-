---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../data/site';
---
<BaseLayout title="Contact" description="Contact Anthony (Tony) Maiorana about science, writing, industrial innovation, and useful projects.">
  <PageIntro eyebrow="Contact / Say hello" title="What are you working on?" description="If something here connects with a question you’re exploring, I’d be glad to hear about it." />
  <section class="wrap contact-grid"><div><h2>Start with an email.</h2><p>A bit about you, what you’re working on, and what caught your attention is a good place to begin.</p><div class="hero-links"><a class="button contact-email" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a></div><p class="coordinates">Washington, DC</p></div><div class="contact-links"><a href={site.polymerist}>The Polymerist <span>Writing <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a><a href={site.linkedin}>LinkedIn <span>Professional background <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a><a href={site.github}>GitHub <span>Code & projects <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none"><path d="M4 16 16 4M4 4h12v12" stroke="currentColor" stroke-width="1.4" /></svg></span></a></div></section>
</BaseLayout>
